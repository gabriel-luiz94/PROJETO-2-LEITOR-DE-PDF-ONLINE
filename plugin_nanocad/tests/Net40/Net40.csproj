<Project Sdk="Microsoft.NET.Sdk">
  <!-- Só para conferir que o NÚCLEO compila como o nanoCAD 5 precisa: .NET Framework 4.0 e C# 5 (o csc do Windows). -->
  <PropertyGroup>
    <TargetFramework>net40</TargetFramework>
    <LangVersion>5</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>Nucleo.Net40</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Nucleo/*.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net40" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
