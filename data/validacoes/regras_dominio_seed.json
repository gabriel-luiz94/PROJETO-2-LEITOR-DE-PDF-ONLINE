{
  "versao": 2,
  "grupos": {
    "ESTRUTURA_MT": [
      "U1",
      "U2",
      "U3",
      "U4",
      "U1C",
      "U2C",
      "U3C",
      "U4C",
      "U23",
      "U32",
      "N1",
      "N2",
      "N3",
      "N4",
      "N1IV",
      "N2IV",
      "N3IV",
      "N4IV",
      "T1",
      "T2",
      "T3",
      "TE",
      "R1",
      "R2",
      "R3",
      "R4"
    ],
    "ISOLADA": [
      "U3",
      "U3C",
      "N3",
      "N3IV",
      "R3",
      "T3"
    ],
    "TRAFO": [
      "TR[0-9]*"
    ],
    "TRAFO_MONO_BI": [
      "TR[12]*"
    ],
    "TRAFO_TRI": [
      "TR3*"
    ],
    "CHAVE_MT": [
      "CFU",
      "CFA",
      "CFUR"
    ],
    "CHAVE_LIBERA_ELO": [
      "CFU",
      "CFUR"
    ],
    "ELO": [
      "EF*"
    ],
    "MT_OU_EQUIP": [
      "@ESTRUTURA_MT",
      "@TRAFO",
      "@CHAVE_MT"
    ],
    "POSTE_10M": [
      {
        "regex": "^\\d*(DT|CV)10/"
      }
    ],
    "ESTRUTURA_SI": [
      {
        "regex": "^SI\\d+$"
      }
    ],
    "ESTRUTURA_S": [
      {
        "regex": "^S\\d+$"
      }
    ]
  },
  "regras": [
    {
      "id": "C2-CFU-SUPL",
      "versao": 2,
      "escopo": "linha",
      "operacoes": [
        "I",
        "*I"
      ],
      "ativa": false,
      "severidade": "aviso",
      "mensagem": "Chave CFU sem 1-SUPL na linha.",
      "descricao": "Basta a presença de 1-SUPL na linha (decisão 2026-09-30).",
      "quando": {
        "tem": "CFU"
      },
      "entao": {
        "soma": "SUPL",
        "qtd": {
          ">=": 1
        }
      }
    },
    {
      "id": "C2-CFU-EF",
      "versao": 2,
      "escopo": "linha",
      "operacoes": [
        "I",
        "*I"
      ],
      "ativa": false,
      "severidade": "aviso",
      "mensagem": "Chave CFU/CFUR sem elo fusível (EF) na mesma linha.",
      "descricao": "",
      "quando": {
        "tem": "@CHAVE_LIBERA_ELO"
      },
      "entao": {
        "soma": "@ELO",
        "qtd": {
          ">=": 1
        }
      }
    },
    {
      "id": "C2-TR-PR15",
      "versao": 2,
      "escopo": "linha",
      "operacoes": [
        "I",
        "*I"
      ],
      "ativa": false,
      "severidade": "aviso",
      "mensagem": "Trafo sem 1-PR15 (nem RPR).",
      "descricao": "",
      "quando": {
        "tem": "@TRAFO"
      },
      "entao": {
        "soma": "PR15",
        "qtd": {
          ">=": 1
        }
      },
      "excecoes": {
        "tem": "RPR"
      }
    },
    {
      "id": "C2-TR-PR220-MONO",
      "versao": 2,
      "escopo": "linha",
      "operacoes": [
        "I",
        "*I"
      ],
      "ativa": false,
      "severidade": "aviso",
      "mensagem": "Trafo monofásico/bifásico com PR220 abaixo do mínimo.",
      "descricao": "Mínimo 2; dobra com duas descidas: 1-SI4 ou SI3 com qtd >= 2 (uma descida: 1-SI3 ou outra estrutura de BT).",
      "quando": {
        "tem": "@TRAFO_MONO_BI"
      },
      "entao": {
        "soma": "PR220",
        "qtd": {
          ">=": {
            "base": 2,
            "vezes": 2,
            "se": {
              "algum": [
                {
                  "soma": "SI4",
                  "qtd": {
                    ">=": 1
                  }
                },
                {
                  "soma": "SI3",
                  "qtd": {
                    ">=": 2
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "id": "C2-TR-PR220-TRI",
      "versao": 2,
      "escopo": "linha",
      "operacoes": [
        "I",
        "*I"
      ],
      "ativa": false,
      "severidade": "aviso",
      "mensagem": "Trafo trifásico com PR220 abaixo do mínimo.",
      "descricao": "Mínimo 3; dobra com duas descidas (idem monofásico).",
      "quando": {
        "tem": "@TRAFO_TRI"
      },
      "entao": {
        "soma": "PR220",
        "qtd": {
          ">=": {
            "base": 3,
            "vezes": 2,
            "se": {
              "algum": [
                {
                  "soma": "SI4",
                  "qtd": {
                    ">=": 1
                  }
                },
                {
                  "soma": "SI3",
                  "qtd": {
                    ">=": 2
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "id": "C2-P50",
      "versao": 2,
      "escopo": "planilha",
      "operacoes": [
        "I",
        "*I"
      ],
      "ativa": false,
      "severidade": "aviso",
      "mensagem": "P50 total da planilha abaixo do necessário para trafos e PR15.",
      "descricao": "Total de P50 (comprimento bruto, tabela Cabos) >= 2 m por trafo mono/bi + 6 m por trafo tri + 1 m por PR15, só operações I/*I.",
      "deve_ser": {
        "esq": {
          "soma_metros": "P50"
        },
        "cmp": ">=",
        "dir": {
          "soma": [
            {
              "vezes": [
                2,
                {
                  "soma_qtd": "@TRAFO_MONO_BI"
                }
              ]
            },
            {
              "vezes": [
                6,
                {
                  "soma_qtd": "@TRAFO_TRI"
                }
              ]
            },
            {
              "vezes": [
                1,
                {
                  "soma_qtd": "PR15"
                }
              ]
            }
          ]
        },
        "rotulos": {
          "esq": "P50 nos cabos (m)",
          "dir": "P50 exigido (m)"
        }
      }
    },
    {
      "id": "C2-POSTE10-MT",
      "versao": 2,
      "escopo": "linha",
      "operacoes": [
        "I",
        "*I"
      ],
      "ativa": false,
      "severidade": "erro",
      "mensagem": "Poste de 10 m não pode ser usado em média tensão.",
      "descricao": "Poste é MT se a linha tem estrutura MT ou chave/trafo de MT (decisão 2026-09-30).",
      "quando": {
        "tem": "@POSTE_10M"
      },
      "entao": {
        "nao": {
          "tem": "@MT_OU_EQUIP"
        }
      }
    },
    {
      "id": "C2-ESTR-ISOL",
      "versao": 2,
      "escopo": "linha",
      "operacoes": [
        "I",
        "*I"
      ],
      "ativa": false,
      "severidade": "aviso",
      "mensagem": "Estrutura de fim de rede sozinha no poste.",
      "descricao": "U3/N3/R3/T3 e variantes exigem outra estrutura MT (mesmo outra isolada) ou trafo: a linha precisa ter pelo menos 2 unidades de estrutura MT/trafo/chave MT (a própria estrutura conta 1).",
      "quando": {
        "tem": "@ISOLADA"
      },
      "entao": {
        "soma": "@MT_OU_EQUIP",
        "qtd": {
          ">=": 2
        }
      }
    },
    {
      "id": "C2-POSTE-FMT",
      "versao": 2,
      "escopo": "linha",
      "operacoes": [
        "I",
        "*I"
      ],
      "ativa": false,
      "severidade": "info",
      "mensagem": "Poste fora do padrão DT…/CV… sem quantidade (o cálculo aceita).",
      "descricao": "Sinaliza POSTE11, 1-DT11/300 e DT11.",
      "quando": {
        "texto": "(?:^|\\s)(?:POSTE\\d+|\\d+(?:[.,]\\d+)?-(?:DT|CV)\\d+/\\d+|(?:DT|CV)\\d+(?=\\s|$))"
      }
    },
    {
      "id": "C2-TR-EF",
      "versao": 2,
      "escopo": "linha",
      "operacoes": [
        "I",
        "*I"
      ],
      "ativa": false,
      "severidade": "aviso",
      "mensagem": "Poste com trafo e elo fusível (EF) sem chave.",
      "descricao": "Não inclua elo em postes com transformador, a menos que haja também uma chave. Chave = CFU ou CFUR (decisão 2026-09-30; CFA não libera).",
      "quando": {
        "tem": "@TRAFO"
      },
      "excecoes": {
        "tem": "@CHAVE_LIBERA_ELO"
      },
      "entao": {
        "nao": {
          "tem": "@ELO"
        }
      }
    },
    {
      "id": "C2-BT-EXT",
      "versao": 2,
      "escopo": "linha",
      "operacoes": [
        "I",
        "*I"
      ],
      "ativa": false,
      "severidade": "aviso",
      "mensagem": "Estrutura SI sem RA2 (e sem estrutura S#) na linha.",
      "descricao": "Se houver estrutura SI (SI1, SI3, SI4…), adicionar RA2, a menos que exista estrutura tipo S# (S2, S4, S44…) (decisão 2026-09-30).",
      "quando": {
        "tem": "@ESTRUTURA_SI"
      },
      "excecoes": {
        "tem": "@ESTRUTURA_S"
      },
      "entao": {
        "soma": "RA2",
        "qtd": {
          ">=": 1
        }
      }
    }
  ]
}
