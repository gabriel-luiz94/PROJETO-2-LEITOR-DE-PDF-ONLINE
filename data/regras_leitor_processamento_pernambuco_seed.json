[
 {
  "fase": 1,
  "ordem": 10,
  "descricao": "Poste compacto (11300D = DT11/300; D, R, F, FV), sozinho ou com itens (9200D, N1); linhas seguintes do mesmo MTEXT (até 2) entram na mesma linha",
  "modo": "DEFINIR",
