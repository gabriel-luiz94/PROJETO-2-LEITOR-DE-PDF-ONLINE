   "regex": "^(?!\\d{4,6}(?:FV|D|R|F)(?:,|$))(.+)$",
   "janela": 2,
   "mesma_pagina": true,
   "direcao": "DEPOIS",
   "mesmo_mtext": true,
   "juntar": true
  }
 },
 {
