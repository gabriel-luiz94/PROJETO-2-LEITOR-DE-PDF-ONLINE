# ── Supabase (OBRIGATÓRIO para modo online) ──────────────────────────────────
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-anon-aqui

# ── Segurança JWT ─────────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=gere-uma-chave-secreta-forte-aqui

# ── Admin Inicial (usado apenas na primeira inicialização) ────────────────────
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=mude-esta-senha

# ── IA ────────────────────────────────────────────────────────────────────────
# Chave PADRÃO do sistema: usada quando o usuário não digita chave própria na interface.
# Servidor: defina como variável de ambiente/secret. Desktop (.exe): arquivo ".env" na mesma
# pasta do executável. Nunca versionar o valor real.
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Chave padrão do sistema para OpenAI e Claude (Anthropic) — mesmo papel das chaves do Gemini
# acima, mesma precedência (usuário > salva > padrão do ambiente). Opcionais: só são usadas
# quando o provedor de IA selecionado é "openai"/"claude" (TASK-055).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Limite de mensagens de IA por usuário por minuto quando a chave padrão está em uso (padrão: 20)
AI_RATE_LIMIT_POR_MINUTO=20
